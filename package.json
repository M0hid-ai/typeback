{
  "name": "typeback",
  "version": "0.1.0",
  "description": "Give your keyboard a voice. Mechanical keyboard sounds for every app on Windows.",
  "main": "src/main/main.js",
  "author": "Mohid Fida",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "packs": "python tools/generate_packs.py",
    "icons": "python tools/generate_icons.py",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "dependencies": {
    "koffi": "^3.2.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mohidfida.typeback",
    "productName": "Typeback",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "packs/**/*",
      "build/*.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/koffi/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Typeback"
    }
  }
}
